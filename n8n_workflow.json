        "jsCode": "const blog = $('FastAPI Store Blog1').first().json;\nconst generated = $('Gemini Generate Posts1').first().json;\nconst quality = $('Groq Grounding & Quality Gate1').first().json;\n\nconst qualityData = JSON.parse(\n  quality.choices[0].message.content\n);\n\nconst posts =\n  generated.candidates?.[0]?.content?.parts?.[0]?.text || \"\";\n\nreturn [\n  {\n    json: {\n      blog_id: blog.blog_id,\n      posts: posts,\n      status: \"blocked\",\n      quality_score: qualityData.quality_score,\n      quality_status: qualityData.status,\n      grounding_score: qualityData.grounding_score,\n      claims_match: qualityData.claims_match,\n      reason: qualityData.reason\n    }\n  }\n];"
