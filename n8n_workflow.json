    {
      "parameters": {
        "jsCode": "const blog = $('FastAPI Store Blog1').first().json;\nconst generated = $('Gemini Generate Posts1').first().json;\nconst quality = $('Groq Grounding & Quality Gate1').first().json;\n\n// Quality parse\nlet rawQuality = quality.choices?.[0]?.message?.content || \"\";\nrawQuality = rawQuality.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\nlet qualityData;\ntry {\n  qualityData = JSON.parse(rawQuality);\n} catch (e) {\n  throw new Error(\"Quality parse error: \" + rawQuality);\n}\n\n// Gemini posts parse\nconst postsRaw = generated.candidates?.[0]?.content?.parts?.[0]?.text || \"\";\nconst finishReason = generated.candidates?.[0]?.finishReason || \"\";\n\n// ✅ MAX_TOKENS check\nif (finishReason === \"MAX_TOKENS\") {\n  throw new Error(\"Gemini output truncated — increase maxOutputTokens to 4096 in Gemini node\");\n}\n\nlet linkedinPost = \"\";\nlet discordPost = \"\";\n\ntry {\n  let cleaned = postsRaw.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n  const jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) cleaned = jsonMatch[0];\n  const parsed = JSON.parse(cleaned);\n  linkedinPost = parsed.linkedin || parsed.LinkedIn || \"\";\n  discordPost  = parsed.discord  || parsed.Discord  || \"\";\n} catch (e) {\n  // Regex fallback — incomplete JSON bhi handle kare\n  const liMatch = postsRaw.match(/\"linkedin\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*,?\\s*\"discord\"/i);\n  const diMatch = postsRaw.match(/\"discord\"\\s*:\\s*\"([\\s\\S]*?)\"\\s*\\}?\\s*$/i);\n\n  if (liMatch) linkedinPost = liMatch[1].replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"').trim();\n  if (diMatch) discordPost  = diMatch[1].replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"').trim();\n\n  // Last resort — linkedin text seedha nikalo agar discord missing bhi ho\n  if (!linkedinPost) {\n    const liOnly = postsRaw.match(/\"linkedin\"\\s*:\\s*\"([\\s\\S]{50,})\"/i);\n    if (liOnly) linkedinPost = liOnly[1].replace(/\\\\n/g, '\\n').replace(/\\\\\"/g, '\"').trim();\n  }\n}\n\nif (!linkedinPost) {\n  throw new Error(\"LinkedIn post empty! finishReason: \" + finishReason + \" | Raw: \" + postsRaw.substring(0, 300));\n}\n\n// image carry forward\nconst webhookBody = $('Webhook Trigger1').first().json.body || {};\nconst fetchedBlog = $('FastAPI Fetch Blog1').first().json || {};\n\nreturn [{\n  json: {\n    blog_id:         blog.blog_id,\n    posts:           postsRaw,\n    linkedin_post:   linkedinPost,\n    discord_post:    discordPost,\n    status:          \"draft\",\n    quality_score:   qualityData.quality_score   ?? 0,\n    quality_status:  qualityData.status          ?? \"REVIEW\",\n    grounding_score: qualityData.grounding_score ?? 0,\n    claims_match:    qualityData.claims_match    ?? false,\n    reason:          qualityData.reason          ?? \"\",\n    has_image:       webhookBody.has_image || fetchedBlog.has_image || false,\n    image_base64:    webhookBody.image_base64 || fetchedBlog.image_base64 || \"\"\n  }\n}];"
      },
