        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  JSON.stringify({\n    contents: [\n      {\n        parts: [\n          {\n            text: `You are a social media content expert. Using the blog content and brand memory below, generate 2 platform-specific posts.\n\nBLOG CONTENT:\n${$('FastAPI Fetch Blog1').item.json.blog_text || \"\"}\n\nBRAND MEMORY / TONE:\n${$json.brand_context || \"\"}\n\nGenerate EXACTLY this JSON structure with no extra text:\n{\n  \"linkedin\": \"[150-200 words, professional tone, storytelling hook, 3 relevant hashtags at end]\",\n  \"discord\": \"[casual, engaging, use 2-3 emojis, max 300 chars, community feel]\"\n}`\n          }\n        ]\n      }\n    ],\n    generationConfig: {\n      temperature: 0.7,\n      maxOutputTokens: 4096\n    }\n  })\n}}",
        "options": {}
      },
      "id": "e56477fb-5abb-49f5-9f1e-805c318dd545",
      "name": "Gemini Generate Posts1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -1936,
        992
      ],
      "retryOnFail": true,
      "notes": "GEMINI ONLY for content generation — gemini-2.0-flash — 1 call per run to save quota. Gemini 2.5 Flash-Lite also works (15RPM, 1000RPD free tier)"
    },
