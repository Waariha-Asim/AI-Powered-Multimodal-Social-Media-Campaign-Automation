td width=\"33%\" style=\"padding-right:12px;\">\n                    <div style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:16px 18px;\">\n                      <p style=\"margin:0 0 6px;font-size:11px;color:#475569;text-transform:uppercase;letter-spacing:1px;\">Blog ID</p>\n                      <p style=\"margin:0;font-size:13px;font-weight:600;color:#a78bfa;\">{{ $('FastAPI Store Blog1').item.json.blog_id }}</p>\n                    </div>\n                  </td>\n                  <td width=\"33%\" style=\"padding-right:12px;\">\n                    <div style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:16px 18px;\">\n                      <p style=\"margin:0 0 6px;font-size:11px;color:#475569;text-transform:uppercase;letter-spacing:1px;\">Quality Score</p>\n                      <p style=\"margin:0;font-size:24px;font-weight:700;color:#22c55e;\">{{ JSON.parse($('Groq Grounding & Quality Gate1').item.json.choices[0].message.content).quality_score }}<span style=\"font-size:13px;color:#475569;font-weight:400;\">/100</span></p>\n                    </div>\n                  </td>\n                  <td width=\"33%\">\n                    <div style=\"background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:16px 18px;\">\n                      <p style=\"margin:0 0 6px;font-size:11px;color:#475569;text-transform:uppercase;letter-spacing:1px;\">Status</p>\n                      <p style=\"margin:0;font-size:13px;font-weight:700;color:#22c55e;\">{{ JSON.parse($('Groq Grounding & Quality Gate1').item.json.choices[0].message.content).status }}</p>\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Validation Details -->\n          <tr>\n            <td style=\"padding:0 36px 24px;\">\n              <div style