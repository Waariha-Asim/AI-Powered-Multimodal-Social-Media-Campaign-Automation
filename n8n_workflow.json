        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  JSON.stringify({\n    model: \"openai/gpt-oss-20b\",\n\n    messages: [\n      {\n        role: \"system\",\n        content: \"You are a strict content fact-checker and quality gate. Return ONLY valid JSON. Do not provide reasoning. Keep the reason under 15 words.\"\n      },\n      {\n        role: \"user\",\n        content: `Evaluate the generated social media posts against the original blog.\n\nGROUNDING:\nCheck whether every factual claim in the generated posts is supported by the original blog. Any unsupported or invented factual claim means claims_match=false.\n\nQUALITY:\nScore 0-100 based on tone, clarity, platform fit, and engagement.\n\nSTATUS:\nPASS = quality_score > 75 AND claims_match=true\nREVIEW = quality_score 50-75 AND claims_match=true\nBLOCK = quality_score < 50 OR claims_match=false\n\nORIGINAL BLOG:\n${($('FastAPI Fetch Blog1').item.json.blog_text || \"\").substring(0, 3000)}\n\nGENERATED POSTS:\n${$('Gemini Generate Posts1').item.json.candidates?.[0]?.content?.parts?.[0]?.text || \"\"}\n\nReturn ONLY:\n{\n  \"grounding_score\": 0,\n  \"claims_match\": true,\n  \"quality_score\": 0,\n  \"status\": \"PASS\",\n  \"reason\": \"brief reason\"\n}`\n      }\n    ],\n\n    reasoning_effort: \"low\",\n    include_reasoning: false,\n\n    response_format: {\n      type: \"json_object\"\n    },\n\n    max_tokens: 500,\n    temperature: 0.1\n  })\n}}",
        "options": {}
      },
      "id": "64647e71-e14f-403d-b6ab-a88c15fb1a1e",
      "name": "Groq Grounding & Quality Gate1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
