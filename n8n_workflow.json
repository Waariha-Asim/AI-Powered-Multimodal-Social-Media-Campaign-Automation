    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  JSON.stringify({\n    model: \"qwen/qwen3.6-27b\",\n\n    messages: [\n      {\n        role: \"system\",\n        content: \"You are a strict image relevance reviewer. Analyze the image and blog together. Return ONLY valid JSON.\"\n      },\n      {\n        role: \"user\",\n        content: [\n          {\n            type: \"image_url\",\n            image_url: {\n              url: (() => {\n                const b64 = $('FastAPI Fetch Blog1').item.json.image_base64 || \"\";\n                return b64.startsWith(\"data:\")\n                  ? b64\n                  : `data:image/png;base64,${b64}`;\n              })()\n            }\n          },\n          {\n            type: \"text\",\n            text: `Check whether this image is relevant to this blog.\n\nBLOG:\n${($('FastAPI Fetch Blog1').item.json.blog_text || \"\").substring(0, 2500)}\n\nReturn ONLY this JSON object:\n\n{\n  \"image_relevant\": true,\n  \"relevance_score\": 85,\n  \"image_quality\": 90,\n  \"image_safe\": true,\n  \"reason\": \"Short reason\"\n}\n\nRules:\n- image_relevant must be true or false\n- relevance_score must be 0-100\n- image_quality must be 0-100\n- image_safe must be true or false\n- reason must be one short sentence\n- No markdown\n- No extra text`\n          }\n        ]\n      }\n    ],\n\n    temperature: 0.1,\n    max_completion_tokens: 300,\n    reasoning_effort: \"none\",\n    include_reasoning: false\n  })\n}}",
        "options": {}
      },
      "id": "f30b16ae-7128-498b-8c24-02fd95f6b003",
      "name": "Groq Multimodal Image Check1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -1360,
        976
      ],
      "notes": "GROQ vision model qwen/qwen3.6-27b — current 2026 Groq vision model. Each image = 2048 tokens. Max 5 images per request."
